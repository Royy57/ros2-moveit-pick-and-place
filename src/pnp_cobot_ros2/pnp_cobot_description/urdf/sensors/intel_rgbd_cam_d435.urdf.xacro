<?xml version="1.0"?>
<!--
  Intel RealSense D435 RGB-D camera: body link, depth/infra/color frames and the Gazebo sensor.

  Modified by: Souvik Roy <sroyy57@gmail.com> (2026) — turned into a macro so the camera can be
  mounted on the stand or on the wrist; box inertia computed from the camera size.

  Links are named after `name`: <name>_link (x forward, z up), <name>_depth_optical_frame, ...
  The Gazebo topic is `name` (<name>/points, <name>/image, <name>/depth_image, <name>/camera_info).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="intel_rgbd_cam_d435" params="name parent use_gazebo near_clip:=0.05 *origin">

    <xacro:property name="d435_cam_width" value="0.090"/>
    <xacro:property name="d435_cam_height" value="0.025"/>
    <xacro:property name="d435_cam_depth" value="0.02505"/>
    <xacro:property name="d435_cam_mass" value="0.072"/>

    <xacro:property name="d435_cam_depth_to_infra1_offset" value="0.0"/>
    <xacro:property name="d435_cam_depth_to_infra2_offset" value="-0.050"/>
    <xacro:property name="d435_cam_depth_to_color_offset" value="0.015"/>

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0.0 ${pi/2}"/>
        <geometry>
          <mesh filename="file://$(find pnp_cobot_description)/meshes/d435/visual/d435.stl" />
        </geometry>
        <material name="aluminum">
          <color rgba="0.5 0.5 0.5 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${d435_cam_depth} ${d435_cam_width} ${d435_cam_height}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${d435_cam_mass}" />
        <origin xyz="0 0 0" />
        <inertia
          ixx="${d435_cam_mass / 12 * (d435_cam_width**2 + d435_cam_height**2)}" ixy="0.0" ixz="0.0"
          iyy="${d435_cam_mass / 12 * (d435_cam_depth**2 + d435_cam_height**2)}" iyz="0.0"
          izz="${d435_cam_mass / 12 * (d435_cam_depth**2 + d435_cam_width**2)}" />
      </inertial>
    </link>

    <joint name="${name}_depth_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${name}_link"/>
      <child link="${name}_depth_frame" />
    </joint>
    <link name="${name}_depth_frame"/>

    <joint name="${name}_depth_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
      <parent link="${name}_depth_frame" />
      <child link="${name}_depth_optical_frame" />
    </joint>
    <link name="${name}_depth_optical_frame"/>

    <joint name="${name}_infra1_joint" type="fixed">
      <origin xyz="0 ${d435_cam_depth_to_infra1_offset} 0" rpy="0 0 0" />
      <parent link="${name}_link" />
      <child link="${name}_infra1_frame" />
    </joint>
    <link name="${name}_infra1_frame"/>

    <joint name="${name}_infra1_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
      <parent link="${name}_infra1_frame" />
      <child link="${name}_infra1_optical_frame" />
    </joint>
    <link name="${name}_infra1_optical_frame"/>

    <joint name="${name}_infra2_joint" type="fixed">
      <origin xyz="0 ${d435_cam_depth_to_infra2_offset} 0" rpy="0 0 0" />
      <parent link="${name}_link" />
      <child link="${name}_infra2_frame" />
    </joint>
    <link name="${name}_infra2_frame"/>

    <joint name="${name}_infra2_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
      <parent link="${name}_infra2_frame" />
      <child link="${name}_infra2_optical_frame" />
    </joint>
    <link name="${name}_infra2_optical_frame"/>

    <joint name="${name}_color_joint" type="fixed">
      <origin xyz="0 ${d435_cam_depth_to_color_offset} 0" rpy="0 0 0" />
      <parent link="${name}_link" />
      <child link="${name}_color_frame" />
    </joint>
    <link name="${name}_color_frame"/>

    <joint name="${name}_color_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
      <parent link="${name}_color_frame" />
      <child link="${name}_color_optical_frame" />
    </joint>
    <link name="${name}_color_optical_frame"/>

    <xacro:if value="${use_gazebo}">
      <gazebo reference="${name}_link">
        <sensor name="${name}" type="rgbd_camera">
          <camera>
            <horizontal_fov>1.5184</horizontal_fov>
            <image>
              <width>424</width>
              <height>240</height>
            </image>
            <clip>
              <near>${near_clip}</near>
              <far>1.5</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <ignition_frame_id>${name}_link</ignition_frame_id>
          <topic>${name}</topic>
          <update_rate>5</update_rate>
          <visualize>true</visualize>
        </sensor>
      </gazebo>
    </xacro:if>

  </xacro:macro>
</robot>
