<?xml version="1.0"?>
<!--
  0.5 m stand for the fixed external camera (moved out of intel_rgbd_cam_d435.urdf.xacro).
  The camera is attached to `torso_link` at the top of the stand.

  @author Souvik Roy <sroyy57@gmail.com>
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="camera_stand" params="parent *origin">

    <link name="torso_link">
      <inertial>
        <origin xyz="0 0 0.50" />
        <mass value="2.5" />
        <inertia ixx="0.8" ixy="0.0" ixz="0.0" iyy="0.8" iyz="0.0" izz="0.8" />
      </inertial>
      <visual name="holder">
        <origin xyz="0 0 0.25" rpy="0 0 0" />
        <material name="LightGrey">
          <color rgba="0.7 0.7 0.7 1.0"/>
        </material>
        <geometry>
          <cylinder radius="0.005" length="0.5"/>
        </geometry>
      </visual>
      <visual name="base">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <material name="LightGrey">
          <color rgba="0.7 0.7 0.7 1.0"/>
        </material>
        <geometry>
          <box size="0.15 0.10 0.06" />
        </geometry>
      </visual>
      <collision name="holder">
        <origin xyz="0 0 0.25" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.005" length="0.6"/>
        </geometry>
      </collision>
      <collision name="base">
        <origin xyz="0 0 0.0" rpy="0 0 0" />
        <geometry>
          <box size="0.15 0.10 0.06" />
        </geometry>
      </collision>
    </link>

    <joint name="${parent}_to_torso_link" type="fixed">
      <parent link="${parent}"/>
      <child link="torso_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

  </xacro:macro>
</robot>
